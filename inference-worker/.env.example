# Inference Worker — Environment Variables
# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าให้ตรงกับ environment ของคุณ

# Redis
REDIS_URL=redis://localhost:6379

# MLflow Tracking Server
MLFLOW_TRACKING_URI=http://localhost:5000

# MinIO / S3 (สำหรับ artifact download จาก MLflow)
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin123

# Model ที่จะโหลดจาก MLflow Registry
MODEL_NAME=bert-base-ner
MODEL_STAGE=Production

# MinIO (fallback)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
